# Host access is configured in the reviewed inventory (docker-constructor.toml)
# and persisted by `./docker/docker-constructor.py doctor` in the local companion.

# Root for the selected constructor project's workspace-selector tree
# (overridable via --workspace-root). Runtime mounts are chosen with
# --workspace and repeatable --extra-workspace; the launcher emits
# WORKSPACE_PATH_1..N and they are not configured in this file.
# WORKSPACE_ROOT=/home/dev/work

# Tool versions are resolved from docker-constructor.toml.
# Use: ./docker/docker-constructor.py build
# Override a version: ./docker/docker-constructor.py build --override build.stages.toolchain.python.version=X.Y.Z

DEV_UID=1000
DEV_GID=1000

# At container start, chown bind-mounted work dirs to dev:dev (fixes EACCES on root-owned mounts)
CHOWN_WORK_ON_START=1
